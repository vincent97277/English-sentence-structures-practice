{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentence materials v1",
  "description": "AI-converted material pack. Local IDs are optional for new materials. Content review and identity checks are required separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source", "items"],
  "properties": {
    "format": { "const": "sentence-materials/v1" },
    "source": { "$ref": "#/$defs/text" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "purpose", "examples"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{3,}$" },
        "pattern": { "$ref": "#/$defs/text" },
        "purpose": { "$ref": "#/$defs/text" },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "notes": { "$ref": "#/$defs/text" },
        "priority": { "enum": ["Core", "High", "Useful"] }
      }
    }
  }
}
